<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.5.16</version>
  </parent>

  <groupId>com.shopivo</groupId>
  <artifactId>shopivo-product-service</artifactId>
  <version>1.0.0</version>

  <properties>
    <java.version>21</java.version>
    <!-- Security overrides -->
    <tomcat.version>11.0.25</tomcat.version>
    <jackson-bom.version>2.21.7</jackson-bom.version>
    <rabbit-amqp-client.version>5.34.0</rabbit-amqp-client.version>
    <netty.version>4.1.137.Final</netty.version>

  </properties>

  <dependencies>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>

    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <version>42.7.12</version>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-amqp</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>

    <dependency>
      <groupId>com.github.spotbugs</groupId>
      <artifactId>spotbugs-annotations</artifactId>
      <version>4.8.6</version>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>

      <!-- For Mavan Lint Test -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-checkstyle-plugin</artifactId>
        <version>3.6.0</version>
        <configuration>
          <configLocation>${project.basedir}/config/checkstyle.xml</configLocation>
          <consoleOutput>true</consoleOutput>
          <failsOnError>true</failsOnError>
          <violationSeverity>warning</violationSeverity>
        </configuration>
        <executions>
          <execution>
          <!-- 1. validate — "Is the Maven project structurally valid?" -->
            <phase>validate</phase>
            <goals>
            <!-- 2. Checkstyle — "Does the code follow our coding rules?" -->
            <!-- 3. compile — "Can Java actually compile this?" -->
            <!-- 4. test — "Does the code behave correctly?" -->
            <!-- 5. package — "Can I build the deployable application?" -->
              <goal>check</goal>
            </goals>
          </execution>
        </executions>
      </plugin>

      <!-- For Mavan Lint Test -->
      <!-- SpotBugs — "Can I find suspicious bugs in the bytecode?" -->
<plugin>
    <groupId>com.github.spotbugs</groupId>
    <artifactId>spotbugs-maven-plugin</artifactId>
    <version>4.9.8.2</version>

    <configuration>
        <excludeFilterFile>
            ${project.basedir}/config/spotbugs-exclude.xml
        </excludeFilterFile>

        <failOnError>true</failOnError>
    </configuration>

    <executions>
        <execution>
            <!-- Run SpotBugs during Maven verify -->
            <phase>verify</phase>
            <goals>
                <goal>check</goal>
            </goals>
        </execution>
    </executions>
</plugin>


    </plugins>
  </build>
</project>
